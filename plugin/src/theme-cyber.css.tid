}
/* ---- v10: writing comfort. Calm neutral slate + soft grey text (about 9:1 instead of near-white on saturated blue), larger line height, big auto-growing writing area (the core grows it with the text, so no drag handle is needed), slim sticky header, usable side-by-side preview ---- */
@media {{$:/config/ext/theme/CyberMedia}} {
html body iframe.tc-edit-texteditor, html body .tc-tiddler-frame iframe.tc-edit-texteditor { background: #161d23 !important; border: 1px solid #2b4352 !important; border-radius: 3px; }
html body textarea.tc-edit-texteditor, html body .tc-tiddler-frame textarea.tc-edit-texteditor { background: #161d23 !important; color: #bcc5c4 !important; caret-color: #5ec8e5; font-size: 16.5px; line-height: 1.75; letter-spacing: .01em; padding: 20px 26px; min-height: max(26rem, 62vh); resize: none; border: 1px solid #2b4352; box-shadow: none; }
html body .tc-tiddler-frame textarea.tc-edit-texteditor:focus { background: #181f26 !important; border-color: #3f7287 !important; box-shadow: none !important; }
html body .tc-page-container-wrapper, html body .tc-page-container-wrapper > div { overflow: clip !important; }
html body .tc-tiddler-edit-frame .tc-tiddler-edit-title { font-size: 0 !important; line-height: 0 !important; min-height: 0 !important; padding: 5px 10px !important; margin: 0 !important; display: flex; justify-content: flex-end; align-items: center; position: sticky; top: 50px; z-index: 6; background: #0a141e !important; border-bottom: 1px solid #1f4256; }
html body .tc-tiddler-edit-frame .tc-tiddler-edit-title .tc-tiddler-controls { font-size: 1rem; line-height: normal; float: none !important; margin: 0 !important; }
html body .tc-tiddler-edit-frame .tc-tiddler-edit-title .tc-tiddler-controls svg { width: 24px; height: 24px; }
html body .tc-tiddler-edit-frame .tc-tiddler-edit-title .tc-tiddler-controls button { margin-left: 10px; }
html body .tc-tiddler-preview { display: grid !important; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 10px 14px; align-items: start; background: transparent !important; border: 0 !important; overflow: visible !important; padding: 0 !important; }
html body .tc-tiddler-preview > .tc-editor-toolbar { grid-column: 1 / -1; }
@media (max-width: 42rem) { html body .tc-tiddler-preview { grid-template-columns: minmax(0,1fr); } html body .tc-tiddler-preview > .tc-tiddler-preview-preview { position: static; max-height: none; } }
html body .tc-tiddler-preview > iframe.tc-edit-texteditor, html body .tc-tiddler-preview > textarea.tc-edit-texteditor { width: 100% !important; min-width: 0; }
html body .tc-tiddler-preview > .tc-tiddler-preview-preview { float: none !important; width: auto !important; min-width: 0; box-sizing: border-box; margin: 0 !important; padding: 16px 24px !important; position: sticky; top: 52px; max-height: calc(100vh - 7rem); overflow: auto; background: #121b22 !important; border: 1px solid #2b4352 !important; border-radius: 3px; color: #bcc5c4; }
}
