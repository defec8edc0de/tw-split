html body #navigator-top li:nth-child(2) svg { width: 28px; height: 28px; }
}
/* ---- v9: content-list links that contain a chevron button: underline only the text, never the chevron / its placeholder (the old border-bottom spanned the whole link and stuck out to the left) ---- */
html body .tc-tiddler-body .toc-item > a.tc-tiddlylink { border-bottom: 0 !important; display: inline-flex; align-items: center; gap: 5px; text-decoration: underline; text-decoration-color: rgba(94,200,229,.35); text-underline-offset: .22em; }
html body .tc-tiddler-body .toc-item > a.tc-tiddlylink:hover { text-decoration-color: #fec503; }
