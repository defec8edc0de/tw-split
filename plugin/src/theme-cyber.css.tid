title: $:/plugins/tw-enc-sync/theme/cyber.css
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/* Cyber overlay for the telmiger "navigator" theme: colours come mostly from $:/palettes/tw-split/Cyber; this sheet adds type, depth and accents.
   NOTE: the framed text editor lives in an <iframe> that takes its colours from the palette, so this overlay expects $:/palettes/tw-split/Cyber to be the active palette (applied once automatically).
   Readability first: 17px humanist sans body, 1.7 line height, >= 7:1 contrast for body text. Off switch: see $:/config/ext/theme/CyberMedia. */
/* Fonts shared with the site (same origin, self-hosted, OFL). Missing files (e.g. file:// copies) fall back to the system fonts below. */
@font-face { font-family: "Atkinson Hyperlegible Next"; font-style: normal; font-weight: 200 800; font-display: swap; src: url(/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2) format("woff2"); unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
@font-face { font-family: "Atkinson Hyperlegible Next"; font-style: normal; font-weight: 200 800; font-display: swap; src: url(/fonts/atkinson-hyperlegible-next-latin-ext-wght-normal.woff2) format("woff2"); unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1E00-1E9F,U+20A0-20AB,U+20AD-20C0,U+2C60-2C7F,U+A720-A7FF; }
@font-face { font-family: "Atkinson Hyperlegible Next"; font-style: italic; font-weight: 200 800; font-display: swap; src: url(/fonts/atkinson-hyperlegible-next-latin-wght-italic.woff2) format("woff2"); unicode-range: U+0000-00FF,U+2000-206F,U+20AC,U+2122; }
@font-face { font-family: "JetBrains Mono"; font-style: normal; font-weight: 100 800; font-display: swap; src: url(/fonts/jetbrains-mono-latin-wght-normal.woff2) format("woff2"); unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
@media {{$:/config/ext/theme/CyberMedia}} {
html body.tc-body { background-color: #0a141e;
  background-image: linear-gradient(rgba(99,164,181,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(99,164,181,.04) 1px, transparent 1px), radial-gradient(ellipse at 25% 0%, #12293c 0%, #0a141e 58%, #060d14 100%);
  background-size: 44px 44px, 44px 44px, auto; background-attachment: fixed; color: #c3d0d8;
  font-family: "Atkinson Hyperlegible Next", "Segoe UI", "Open Sans", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif; }
html body ::selection { background: #fec503; color: #06101a; }
html body { scrollbar-color: #28576c #07101a; }
/* chrome: top bar, bottom bar */
html body .tc-topbar, html body span.tc-topbar-right, html body .tc-topbar-left { background: #050b12 !important; border-bottom: 1px solid rgba(36,158,189,.55); box-shadow: 0 1px 14px rgba(36,158,189,.25); }
html body #navigator-main { background: #07121c !important; border-top: 1px solid rgba(36,158,189,.55); box-shadow: 0 -1px 14px rgba(36,158,189,.2); color: #9fdcec; }
