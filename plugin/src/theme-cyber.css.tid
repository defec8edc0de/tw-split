/* code, quotes, tables, details */
html body pre, html body code { background: #07121b; color: #a9dceb; border: 1px solid #1e4455; border-radius: 2px; font-family: "JetBrains Mono", ui-monospace, "Cascadia Mono", "SFMono-Regular", Consolas, "Courier New", monospace; }
